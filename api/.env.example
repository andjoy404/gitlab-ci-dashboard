# Required
GITLAB_BASE_URL=https://gitlab.com
# The Runners page requires a token with manage_runner scope and suitable
# group access (Owner, Auditor, or a custom admin_runners role).
GITLAB_API_TOKEN=glpat-change-me

# Recommended dashboard scope and branding
UI_COMPANY_NAME=Example Company
GITLAB_GROUP_ONLY_IDS=10001
GITLAB_GROUP_ONLY_TOP_LEVEL=true
GITLAB_GROUP_INCLUDE_SUBGROUPS=true

# Optional login protection
# Authentication is disabled when both variables are omitted.
# If enabled, username and password must both be set.
#APP_LOGIN_USERNAME=admin
#APP_LOGIN_PASSWORD=change-me
# Use true only when the dashboard is served over HTTPS.
#APP_LOGIN_SECURE_COOKIE=false

# Optional GitLab scope filters
# Comma-separated IDs are supported.
#GITLAB_GROUP_SKIP_IDS=10023,10024
#GITLAB_PROJECT_SKIP_IDS=20023,20024

# Optional cache TTLs in seconds
#GITLAB_GROUP_CACHE_TTL_SECONDS=300
#GITLAB_PROJECT_CACHE_TTL_SECONDS=300
#GITLAB_BRANCH_CACHE_TTL_SECONDS=60
#GITLAB_JOB_CACHE_TTL_SECONDS=5
#GITLAB_PIPELINE_CACHE_TTL_SECONDS=30
#GITLAB_SCHEDULE_CACHE_TTL_SECONDS=300
# Runner availability is cached longer than active jobs to reduce GitLab API calls.
#GITLAB_RUNNER_CACHE_TTL_SECONDS=60
# Self-hosted runner metadata such as tags changes infrequently.
#GITLAB_RUNNER_DETAIL_CACHE_TTL_SECONDS=300
#GITLAB_RUNNER_JOB_CACHE_TTL_SECONDS=15
#GITLAB_ARTIFACT_CACHE_TTL_SECONDS=1800

# Optional pipeline history
# Used for historical endpoints such as scheduled pipeline history.
# The Pipelines page keeps the newest pipeline per branch in this window.
#GITLAB_PIPELINE_HISTORY_DAYS=5

# Optional UI behavior
#API_READ_ONLY=true
#UI_HIDE_WRITE_ACTIONS=false
#UI_PAGE_SIZE_OPTIONS=10,20,30,40,50
#UI_DEFAULT_PAGE_SIZE=10

# Optional server settings
#SERVER_LISTEN_IP=0.0.0.0
#SERVER_LISTEN_PORT=8080
#SERVER_WORKER_COUNT=2
